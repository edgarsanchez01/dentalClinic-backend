# DentalClinic - variables de entorno (ejemplo).
#
# Copiar a `.env` solo en entornos locales. NUNCA versionar un `.env` real:
# no hay secretos en el repositorio (Architecture.md 19.2, Agents.md 5.4).
#
# En produccion NO se usan valores por defecto: `application-prod.properties`
# exige DB_URL, DB_USERNAME y DB_PASSWORD. Si falta alguno, el arranque falla.

# --- Puerto del PostgreSQL de desarrollo (docker-compose.dev.yml) ---
# Puerto publicado en el HOST. PostgreSQL siempre escucha en 5432 dentro del
# contenedor. Si lo cambias, el puerto de DB_URL de abajo debe coincidir.
POSTGRES_HOST_PORT=5434

# --- Base de datos (PostgreSQL 14+) ---
# Base de datos de DESARROLLO. Nunca `dental` (Agents.md Regla 18).
# El puerto debe ser el mismo que POSTGRES_HOST_PORT.
DB_URL=jdbc:postgresql://localhost:5434/dentalclinic_dev
DB_USERNAME=dentalclinic
DB_PASSWORD=dentalclinic
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
DB_CONNECTION_TIMEOUT_MS=10000

# --- Servidor ---
SERVER_PORT=8080

# --- Guardas de fixtures (Architecture.md 13.3) ---
# false = segunda barrera cerrada. Las fixtures de Fase 1 no existen.
FIXTURES_ENABLED=false
FIXTURES_EXPECTED_DATABASE=dentalclinic_dev

# --- Produccion (sin valores por defecto; se inyectan en el despliegue) ---
# DB_URL=jdbc:postgresql://db-interno:5432/dentalclinic_prod
# DB_USERNAME=...
# DB_PASSWORD=...
# SERVER_PORT=8080

# --- Comunicaciones / SMTP (F8/T1) ---
# Por defecto NO se envia ningun correo real: el dispatcher solo despacha si
# COMMUNICATION_DISPATCH_ENABLED=true y solo envia si COMMUNICATION_EMAIL_ENABLED=true
# y SPRING_MAIL_HOST esta definido. Sin esa configuracion las comunicaciones
# quedan PENDING y nunca se marcan SENT.
#
# NUNCA versionar credenciales SMTP reales: van solo en el .env local o en el
# gestor de secretos del despliegue.
COMMUNICATION_DISPATCH_ENABLED=false
COMMUNICATION_EMAIL_ENABLED=false
COMMUNICATION_EMAIL_FROM=no-reply@dentalclinic.local

# --- Productor de recordatorios (T4.1), incluso sin SMTP ---
APPOINTMENT_REMINDER_ENABLED=false
APPOINTMENT_REMINDER_INTERVAL=60s
APPOINTMENT_REMINDER_INITIAL_DELAY=30s
APPOINTMENT_REMINDER_BATCH_SIZE=50
APPOINTMENT_REMINDER_MAX_BATCHES=10
# Entrega opt-in, default false; T4.2 comprueba vigencia antes de SMTP.
# Con false los REMINDER vigentes permanecen PENDING, con 0 intentos; los obsoletos se invalidan.
# No afecta a CREATED/RESCHEDULED/CANCELLED.
APPOINTMENT_REMINDER_EMAIL_DELIVERY_ENABLED=false

# --- Enlaces de identidad (F8B) ---
# Reconstruccion de enlaces de invitacion/recuperacion. Apagada por defecto;
# valores vacios permitidos con false, valores presentes siempre validados.
# Al habilitarlo (true) son obligatorias la URL y una clave dedicada de al menos
# 32 caracteres; el arranque falla si faltan. La URL debe ser HTTPS (HTTP solo
# localhost/127.0.0.1). IDENTITY_LINK_SECRET es un secreto real: NUNCA se
# versiona y NO reutiliza JWT_SECRET. No habilita ningun envio de correo.
IDENTITY_LINKS_ENABLED=false
IDENTITY_PUBLIC_BASE_URL=http://localhost:5173
IDENTITY_LINK_SECRET=

# --- Outbox independiente de identidad (8B.2; V018 solo probada en efimero) ---
# Productores conectados en 8B.3. No activar SMTP ni migrar la persistente en esta fase.
# El job requiere tambien enlaces configurados y el adaptador COMMUNICATION_EMAIL_ENABLED.
# No depende de COMMUNICATION_DISPATCH_ENABLED (ese job es solo de citas).
IDENTITY_EMAIL_DISPATCH_ENABLED=false
IDENTITY_EMAIL_DISPATCH_INTERVAL=60s
IDENTITY_EMAIL_DISPATCH_INITIAL_DELAY=30s
IDENTITY_EMAIL_DISPATCH_BATCH_SIZE=20
IDENTITY_EMAIL_DISPATCH_MAX_ATTEMPTS=4
IDENTITY_EMAIL_DISPATCH_INITIAL_BACKOFF=1m
IDENTITY_EMAIL_DISPATCH_BACKOFF_MULTIPLIER=5
IDENTITY_EMAIL_DISPATCH_MAX_BACKOFF=1h
# Debe cubrir el lote completo; establecer timeouts SMTP antes de habilitar entregas.
IDENTITY_EMAIL_DISPATCH_LEASE=5m

# --- Antiabuso D4 (8B.3), siempre activo; valores tecnicos configurables ---
# Con enlaces configurados: cuota de emisiones por cuenta durable en outbox, bajo lock de usuario.
# Un reset vigente entregable se reutiliza sin revocarlo ni prolongarlo; no hay otro email hasta
# su consumo/expiracion o que su entrega deje de ser utilizable. Login y consumo no se bloquean.
IDENTITY_RESET_COOLDOWN=1m
IDENTITY_RESET_WINDOW=1h
IDENTITY_RESET_MAX_PER_ACCOUNT=3
# Con transporte HMAC, el alta inicial tambien cuenta; rechazos no invalidan la invitacion vigente.
IDENTITY_STAFF_COOLDOWN=1m
IDENTITY_STAFF_WINDOW=1h
IDENTITY_STAFF_MAX_PER_ACCOUNT=5
# Cuotas IP locales por proceso, memoria acotada; reinicio las reinicia. No sustituyen al edge.
IDENTITY_IP_WINDOW=15m
IDENTITY_RESET_MAX_PER_IP=20
IDENTITY_STAFF_MAX_PER_IP=30
IDENTITY_IP_MAX_ENTRIES=10000
# Vacio = ignorar todas las cabeceras de IP. Solo IP/CIDR de proxies reales que saneen XFF.
# Mantener server.forward-headers-strategy=none; nunca confiar la red de clientes completa.
IDENTITY_TRUSTED_PROXIES=

# Credenciales SMTP (solo si se habilita el envio real). Spring Boot las lee
# por su binding relajado (SPRING_MAIL_HOST -> spring.mail.host).
# SPRING_MAIL_HOST=smtp.example.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=...
# SPRING_MAIL_PASSWORD=...
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
